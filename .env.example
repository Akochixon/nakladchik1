# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=123456:AAExample

# Adminlarning Telegram ID raqamlari, vergul bilan ajratilgan
# (o'z ID raqamingizni @userinfobot orqali bilib olishingiz mumkin)
ADMIN_IDS=111111111,222222222

# PostgreSQL ulanish manzili (Railway avtomatik beradi)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Google Gemini API kaliti (https://aistudio.google.com/apikey dan bepul olinadi)
GEMINI_API_KEY=your_gemini_api_key_here
